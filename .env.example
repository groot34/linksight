# ==============================================================================
# LinkSight Environment Configuration Example
# Copy this file to `.env` and populate your values.
# NEVER commit your actual `.env` file to version control.
# ==============================================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Optional Basic API Key Access Control (Leave empty in local dev to disable key requirement)
API_KEY=your_secret_api_key_here

# Set to "true" ONLY when you explicitly want to verify your cookie on startup.
# WARNING: This makes one real request to LinkedIn on every server restart — leave false by default.
VALIDATE_AUTH_ON_START=false

# LinkedIn Authentication (Manual Session Injection - ZERO automated login)
# 1. Log into linkedin.com in your regular browser.
# 2. Open DevTools (F12) -> Application -> Cookies -> https://www.linkedin.com
# 3. Copy the `li_at` cookie value:
LI_AT_COOKIE=your_li_at_cookie_value_here
# 4. Copy the `JSESSIONID` cookie value (used as the CSRF token header):
LI_JSESSIONID=ajax:your_jsessionid_here

# Volume & Rate Limiting Guardrails (Protects account from getting flagged)
# Hard daily cap on live outbound requests to LinkedIn (resets every 24 hours)
# Keep this LOW for a personal account. Restarting the server does not reset the cap (persisted in data/).
DAILY_REQUEST_CAP=3

# Minimum cooldown delay in seconds between any two live outbound requests to LinkedIn
REQUEST_COOLDOWN_SECONDS=7

# Cache TTL in hours for profile results (avoids repeating requests during demos)
CACHE_TTL_HOURS=24
